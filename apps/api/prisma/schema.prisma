// RicherWealth Prisma Schema — Phase 5: Mutual Funds, ETFs & Bonds (extends Phase 4)
// Conventions:
//   - UUIDs for all primary keys (cuid for URL-safety)
//   - All monetary values store an explicit currencyCode; never convert at write-time
//   - JSONB `details` column on Asset/Liability for type-specific fields
//   - Soft-delete pattern: deletedAt timestamp, never hard-delete financial records

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, uuidOssp(map: "uuid-ossp")]
}

// ─── Enums ────────────────────────────────────────────────────────────────────

/// Phase 5: Bond type discriminator
enum BondType {
  GOVT
  CORPORATE
  MUNICIPAL
  SGB
}

/// Investment mode for mutual fund holdings
enum MfInvestmentType {
  SIP
  LUMPSUM
}

/// Asset top-level category discriminator
enum AssetType {
  CASH
  FIXED_DEPOSIT
  STOCK
  MUTUAL_FUND
  ETF
  BOND
  CRYPTO
  GOLD
  SILVER
  COMMODITY
  REAL_ESTATE
  VEHICLE
  COLLECTIBLE
  NFT
  BUSINESS_EQUITY
  PRIVATE_EQUITY
  ANGEL_INVESTMENT
  REIT
  P2P_LENDING
  RETIREMENT_ACCOUNT
  INSURANCE
  FOREX
  OTHER
}

/// Liability type discriminator
enum LiabilityType {
  MORTGAGE
  CAR_LOAN
  EDUCATION_LOAN
  PERSONAL_LOAN
  CREDIT_CARD
  OTHER
}

/// How often a loan's scheduled payment is due — drives the amortization engine's period count.
enum LoanPaymentFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
}

/// Phase 13: financial-goal type discriminator
enum GoalType {
  HOUSE
  MARRIAGE
  VACATION
  EDUCATION
  EMERGENCY_FUND
  RETIREMENT
  CAR
  CUSTOM
}

/// Household role for RBAC
enum HouseholdRole {
  OWNER
  MEMBER
  VIEWER
}

/// Passkey/authenticator device type
enum PasskeyDeviceType {
  SINGLE_DEVICE
  MULTI_DEVICE
}

// ─── Core Models ──────────────────────────────────────────────────────────────

/// Platform user — synced from Supabase Auth on first login
model User {
  id                  String    @id @default(cuid())
  /// Supabase auth UID — links JWT sub claim to this row
  supabaseId          String    @unique
  email               String    @unique
  name                String?
  avatarUrl           String?
  baseCurrency        String    @default("USD") // ISO 4217
  mfaEnabled          Boolean   @default(false)
  /// TOTP secret (encrypted at application layer before storing)
  mfaTotpSecret       String?
  onboardingCompleted Boolean   @default(false)
  /// Stores the "what do you want to track" quick-pick selections
  trackingPreferences Json      @default("[]")
  /// Phase 16 zero-knowledge vault: PBKDF2 salt (base64), NOT secret, safe to
  /// store server-side — the vault passphrase itself is never sent/stored.
  /// Regenerating this orphans every existing VaultDocument (their AES key
  /// can no longer be re-derived), so VaultService only ever creates it once.
  vaultKeySaltB64     String?
  /// AES-GCM ciphertext/IV of a known constant, encrypted client-side at
  /// vault setup with the just-derived key. Lets the "unlock vault" screen
  /// verify a re-entered passphrase immediately (GCM auth-tag failure on
  /// decrypt = wrong passphrase) without needing a real document to exist.
  /// Reveals nothing about the passphrase or any document content.
  vaultCanaryB64      String?
  vaultCanaryIvB64    String?
  vaultSetupAt        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  // Relations
  assets                Asset[]
  liabilities           Liability[]
  transactions          Transaction[]
  householdMemberships  HouseholdMember[]
  sessions              Session[]
  passkeys              Passkey[]
  netWorthSnapshots     NetWorthSnapshot[]
  stockHoldings         StockHolding[]
  watchlists            Watchlist[]
  // Phase 5
  mutualFundHoldings    MutualFundHolding[]
  etfHoldings           EtfHolding[]
  bondHoldings          BondHolding[]
  // Phase 6
  cryptoHoldings        CryptoHolding[]
  cryptoPriceAlerts     CryptoPriceAlert[]
  // Phase 7
  preciousMetalHoldings PreciousMetalHolding[]
  commodityHoldings     CommodityHolding[]
  // Phase 8
  realEstateDetails     RealEstateDetail[]
  assetRevaluations     AssetRevaluation[]
  // Phase 10
  incomes               Income[]
  categoryRules         CategoryRule[]
  plaidItems            PlaidItem[]
  // Phase 12
  riskScoreSnapshots    RiskScoreSnapshot[]
  // Phase 13
  goals                 Goal[]
  // Phase 14
  ipoListingsCreated    IpoListing[]
  // Phase 15
  taxLots               TaxLot[]
  taxLotDisposals       TaxLotDisposal[]
  itrDocuments          ItrDocument[]
  // Phase 16
  vaultDocuments        VaultDocument[]
  // Phase 17
  stockPriceAlerts      StockPriceAlert[]
  notifications         Notification[]
  notificationPrefs     NotificationPreference[]
  pushTokens            PushToken[]
  // Phase 19
  portfolioEmbeddings   PortfolioEmbedding[]
  aiConversations       AiConversation[]
  aiReports             AiReport[]
  aiSuggestions         AiSuggestion[]

  /// Phase 17 quiet hours — local "HH:mm" strings interpreted in
  /// notifyQuietHoursTimezone (IANA name). Only gates push/email delivery;
  /// in-app notifications are never suppressed (they're not interruptive —
  /// they just sit in the bell until opened). Null on either bound means
  /// quiet hours are off.
  notifyQuietHoursStart    String?
  notifyQuietHoursEnd      String?
  notifyQuietHoursTimezone String  @default("UTC")

  @@index([email])
  @@index([supabaseId])
  @@map("users")
}

/// Active user session — tracked so users can revoke them
model Session {
  id                String    @id @default(cuid())
  userId            String
  /// Supabase session ID for cross-reference
  supabaseSessionId String?   @unique
  deviceName        String? // e.g. "Chrome on macOS"
  deviceType        String? // "desktop" | "mobile" | "tablet"
  ipAddress         String?
  userAgent         String?
  lastSeenAt        DateTime  @default(now())
  expiresAt         DateTime?
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([revokedAt])
  @@map("sessions")
}

/// WebAuthn passkey credential
model Passkey {
  id           String            @id @default(cuid())
  userId       String
  /// Raw credential ID from WebAuthn (base64url encoded)
  credentialId String            @unique
  /// COSE public key (base64url encoded)
  publicKey    String
  /// Signature counter — must be monotonically increasing to detect cloning
  counter      BigInt            @default(0)
  deviceType   PasskeyDeviceType @default(MULTI_DEVICE)
  /// Human-readable label set by the user
  name         String            @default("My Passkey")
  backedUp     Boolean           @default(false)
  transports   String[]
  createdAt    DateTime          @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

/// Family / shared household (for Family Office mode)
model Household {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members HouseholdMember[]

  @@map("households")
}

/// Junction: user ↔ household with role
model HouseholdMember {
  id          String        @id @default(cuid())
  userId      String
  householdId String
  role        HouseholdRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([userId, householdId])
  @@map("household_members")
}

/// Generic asset record — every asset class is a row here.
model Asset {
  id           String    @id @default(cuid())
  userId       String
  type         AssetType
  name         String
  currentValue Decimal   @db.Decimal(20, 6)
  currencyCode String
  details      Json      @default("{}")
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions         Transaction[]
  stockHolding         StockHolding?
  // Phase 5
  mutualFundHolding    MutualFundHolding?
  etfHolding           EtfHolding?
  bondHolding          BondHolding?
  // Phase 6
  cryptoHolding        CryptoHolding?
  // Phase 7
  preciousMetalHolding PreciousMetalHolding?
  commodityHolding     CommodityHolding?
  // Phase 8
  realEstateDetail     RealEstateDetail?
  revaluations         AssetRevaluation[]
  // Phase 15
  taxLots              TaxLot[]
  // Phase 16
  vaultDocuments       VaultDocument[]

  @@index([userId])
  @@index([userId, type])
  @@index([deletedAt])
  @@map("assets")
}

/// Liability (loan/debt) record
model Liability {
  id                String               @id @default(cuid())
  userId            String
  type              LiabilityType
  name              String
  principalAmount   Decimal              @db.Decimal(20, 6)
  remainingBalance  Decimal              @db.Decimal(20, 6)
  interestRate      Decimal              @db.Decimal(8, 4)
  currencyCode      String
  emiAmount         Decimal?             @db.Decimal(20, 6)
  dueDate           DateTime?
  startDate         DateTime?
  maturityDate      DateTime?
  /// Amortized loan types (mortgage/car/education/personal): payment cadence for the amortization engine. Ignored for CREDIT_CARD.
  paymentFrequency  LoanPaymentFrequency @default(MONTHLY)
  /// Amortized loan types: total tenure in months, always expressed in months regardless of paymentFrequency. Required to generate an amortization schedule; null for CREDIT_CARD.
  tenureMonths      Int?
  /// CREDIT_CARD only: minimum payment as % of balance (e.g. 2.00 = 2%). Defaults to 2% at the calculation layer when unset.
  minPaymentPercent Decimal?             @db.Decimal(5, 2)
  /// CREDIT_CARD only: flat-dollar floor on the minimum payment. Defaults to 25 (in currencyCode) at the calculation layer when unset.
  minPaymentFlat    Decimal?             @db.Decimal(20, 6)
  details           Json                 @default("{}")
  notes             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  deletedAt         DateTime?

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions     Transaction[]
  linkedRealEstate RealEstateDetail[]

  @@index([userId])
  @@index([userId, type])
  @@map("liabilities")
}

/// Financial transaction — append-only ledger
model Transaction {
  id                  String   @id @default(cuid())
  userId              String
  assetId             String?
  liabilityId         String?
  type                String
  amount              Decimal  @db.Decimal(20, 6)
  currencyCode        String
  quantity            Decimal? @db.Decimal(20, 8)
  pricePerUnit        Decimal? @db.Decimal(20, 6)
  date                DateTime
  category            String?
  merchant            String?
  description         String?
  source              String   @default("manual")
  /// Provider-side stable ID (e.g. Plaid transaction_id) — used to dedupe bank-synced imports. Null for manual entries and CSV/PDF rows (deduped by date+amount+merchant instead, since statements don't carry a stable ID).
  externalId          String?
  /// True when auto-categorization couldn't confidently match a rule (fell back to OTHER) — surfaced to the user as a review queue; correcting one teaches the per-user CategoryRule table.
  needsCategoryReview Boolean  @default(false)
  details             Json     @default("{}")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset     Asset?     @relation(fields: [assetId], references: [id])
  liability Liability? @relation(fields: [liabilityId], references: [id])

  @@index([userId])
  @@index([userId, date])
  @@index([userId, type])
  @@index([assetId])
  @@index([userId, externalId])
  @@map("transactions")
}

/// Daily net-worth snapshot — written by nightly cron, used for trend charts and delta calculations
model NetWorthSnapshot {
  id               String   @id @default(cuid())
  userId           String
  totalAssets      Decimal  @db.Decimal(24, 6)
  totalLiabilities Decimal  @db.Decimal(24, 6)
  netWorth         Decimal  @db.Decimal(24, 6)
  baseCurrency     String
  snapshotDate     DateTime @db.Date // date only — one row per user per day

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, snapshotDate])
  @@index([userId, snapshotDate])
  @@map("net_worth_snapshots")
}

/// Phase 12: one row per user per day, written whenever the risk profile is
/// (re)computed — mirrors NetWorthSnapshot's upsert-by-date pattern so the
/// Risk page can chart a historical trend the same way the dashboard charts
/// net worth. subScores stores the full RiskSubScore[] (score/level/
/// explanation per dimension) so the trend chart can show dimension-level
/// history later without a schema change.
model RiskScoreSnapshot {
  id           String   @id @default(cuid())
  userId       String
  overallScore Float
  subScores    Json
  snapshotDate DateTime @db.Date // date only — one row per user per day

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, snapshotDate])
  @@index([userId, snapshotDate])
  @@map("risk_score_snapshots")
}

/// Phase 13: a savings/investment goal with a target amount and date.
/// Progress is tracked two ways, combinable: `linkedAssetIds` (summed live
/// from those Asset rows' currentValue, base-currency-converted) plus
/// `standaloneProgressAmount` (a plain manually-updated figure, for goals
/// with no dedicated holding — e.g. a "Vacation" goal saved for in a
/// generic bank account not tracked as its own Asset). Either or both may
/// be used; GoalsService.getProgress() sums whichever apply.
model Goal {
  id                       String    @id @default(cuid())
  userId                   String
  type                     GoalType
  name                     String
  targetAmount             Decimal   @db.Decimal(20, 6)
  targetDate               DateTime  @db.Date
  currencyCode             String
  linkedAssetIds           String[]  @default([])
  standaloneProgressAmount Decimal   @default(0) @db.Decimal(20, 6)
  notes                    String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  deletedAt                DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, deletedAt])
  @@map("goals")
}

/// Forex rate cache — refreshed hourly by ForexService
model ForexRate {
  id        String   @id @default(cuid())
  fromCode  String // ISO 4217
  toCode    String // ISO 4217
  rate      Decimal  @db.Decimal(20, 8)
  fetchedAt DateTime @default(now())

  @@unique([fromCode, toCode])
  @@index([fromCode, toCode])
  @@map("forex_rates")
}

// ─── Phase 4: Stock Holdings & Price Sync ─────────────────────────────────────

/// Stock holding — linked 1:1 to a generic Asset row (type=STOCK)
/// Asset.currentValue is kept in sync whenever price updates.
model StockHolding {
  id           String    @id @default(cuid())
  assetId      String    @unique // FK → Asset
  userId       String
  ticker       String // e.g. "AAPL", "RELIANCE"
  exchange     String // e.g. "NASDAQ", "NSE", "BSE", "NYSE", "LSE", "HKEX"
  quantity     Decimal   @db.Decimal(20, 8) // supports fractional shares
  avgBuyPrice  Decimal   @db.Decimal(20, 6)
  currency     String // currency of avgBuyPrice
  purchaseDate DateTime?
  lastSyncAt   DateTime? // when price was last fetched
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([ticker, exchange])
  @@map("stock_holdings")
}

/// Latest price snapshot per ticker — written by PriceSyncService
model StockPrice {
  id            String   @id @default(cuid())
  ticker        String
  exchange      String
  price         Decimal  @db.Decimal(20, 6)
  previousClose Decimal? @db.Decimal(20, 6)
  dayHigh       Decimal? @db.Decimal(20, 6)
  dayLow        Decimal? @db.Decimal(20, 6)
  volume        BigInt?
  pe            Decimal? @db.Decimal(12, 4) // P/E ratio from provider
  eps           Decimal? @db.Decimal(12, 4) // Earnings per share
  bvps          Decimal? @db.Decimal(12, 4) // Book value per share (for Graham)
  dividendYield Decimal? @db.Decimal(8, 4) // annual yield %
  currency      String // currency of price
  provider      String // "alpha_vantage" | "finnhub" | "twelve_data"
  fetchedAt     DateTime @default(now())

  @@unique([ticker, exchange])
  @@index([ticker, exchange])
  @@map("stock_prices")
}

/// User-created watchlist (can have multiple)
model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  name      String   @default("My Watchlist")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WatchlistItem[]

  @@index([userId])
  @@map("watchlists")
}

/// Individual ticker in a watchlist
model WatchlistItem {
  id          String   @id @default(cuid())
  watchlistId String
  ticker      String
  exchange    String
  addedAt     DateTime @default(now())

  watchlist Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, ticker, exchange])
  @@index([watchlistId])
  @@map("watchlist_items")
}

// ─── Phase 5: Mutual Funds ────────────────────────────────────────────────────

/// Mutual fund holding — linked 1:1 to an Asset row (type=MUTUAL_FUND)
/// Asset.currentValue = unitsHeld × latestNAV, kept in sync by nav-sync job.
model MutualFundHolding {
  id             String           @id @default(cuid())
  assetId        String           @unique // FK → Asset
  userId         String
  /// MFAPI.in scheme code (numeric string, e.g. "120503" for Axis Bluechip)
  schemeCode     String
  fundName       String
  investmentType MfInvestmentType @default(LUMPSUM)
  unitsHeld      Decimal          @db.Decimal(20, 8)
  avgNAV         Decimal          @db.Decimal(20, 6) // weighted avg of all purchases
  /// Expense ratio % (user-entered or looked up; optional)
  expenseRatio   Decimal?         @db.Decimal(6, 4)
  isin           String?
  lastNavSyncAt  DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  asset           Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sipInstallments SipInstallment[]

  @@index([userId])
  @@index([schemeCode])
  @@map("mutual_fund_holdings")
}

/// Individual SIP installment — each is a distinct cash-flow for XIRR
model SipInstallment {
  id                  String   @id @default(cuid())
  mutualFundHoldingId String
  /// Amount invested in this installment (in fund currency)
  amount              Decimal  @db.Decimal(20, 6)
  /// Units allotted for this installment
  units               Decimal  @db.Decimal(20, 8)
  /// NAV at time of purchase
  nav                 Decimal  @db.Decimal(20, 6)
  date                DateTime @db.Date
  createdAt           DateTime @default(now())

  mutualFundHolding MutualFundHolding @relation(fields: [mutualFundHoldingId], references: [id], onDelete: Cascade)

  @@index([mutualFundHoldingId])
  @@index([date])
  @@map("sip_installments")
}

/// Historical NAV data from MFAPI.in — one row per scheme per day
model NavHistory {
  id         String   @id @default(cuid())
  schemeCode String
  date       DateTime @db.Date
  nav        Decimal  @db.Decimal(20, 6)
  createdAt  DateTime @default(now())

  @@unique([schemeCode, date])
  @@index([schemeCode, date])
  @@map("nav_history")
}

// ─── Phase 5: ETFs ────────────────────────────────────────────────────────────

/// ETF holding — linked 1:1 to an Asset row (type=ETF)
/// Reuses the stock price pipeline (PriceSyncService) since ETFs trade like stocks.
model EtfHolding {
  id           String    @id @default(cuid())
  assetId      String    @unique // FK → Asset
  userId       String
  ticker       String // e.g. "NIFTYBEES", "SPY"
  exchange     String // e.g. "NSE", "NASDAQ"
  unitsHeld    Decimal   @db.Decimal(20, 8)
  avgBuyPrice  Decimal   @db.Decimal(20, 6)
  currency     String
  purchaseDate DateTime?
  lastSyncAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([ticker, exchange])
  @@map("etf_holdings")
}

// ─── Phase 5: Bonds ───────────────────────────────────────────────────────────

/// Bond holding — linked 1:1 to an Asset row (type=BOND)
/// currentValue = quantityHeld × faceValue (book value; market pricing deferred to Phase 6)
model BondHolding {
  id            String    @id @default(cuid())
  assetId       String    @unique // FK → Asset
  userId        String
  issuer        String
  bondType      BondType  @default(CORPORATE)
  faceValue     Decimal   @db.Decimal(20, 6)
  couponRate    Decimal   @db.Decimal(8, 4) // annual % e.g. 7.25
  maturityDate  DateTime  @db.Date
  quantityHeld  Int // number of bonds
  purchaseDate  DateTime? @db.Date
  purchasePrice Decimal?  @db.Decimal(20, 6) // price paid per bond
  isin          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([maturityDate])
  @@map("bond_holdings")
}

// ─── Phase 6: Crypto ──────────────────────────────────────────────────────────

/// Crypto holding — linked 1:1 to an Asset row (type=CRYPTO).
/// walletAddress is optional, read-only tracking metadata only — never a
/// private key or seed phrase, and never requested/stored.
model CryptoHolding {
  id            String    @id @default(cuid())
  assetId       String    @unique // FK → Asset
  userId        String
  /// CoinGecko coin id, e.g. "bitcoin", "ethereum", "solana"
  coinId        String
  symbol        String // e.g. "BTC" (denormalized for display)
  name          String // e.g. "Bitcoin" (denormalized for display)
  quantity      Decimal   @db.Decimal(28, 10) // crypto needs far more decimal precision than fiat
  avgBuyPrice   Decimal   @db.Decimal(20, 6)
  currency      String
  /// Public wallet address for read-only reference only (e.g. to cross-check
  /// holdings on a block explorer). No private keys or seed phrases.
  walletAddress String?
  purchaseDate  DateTime? @db.Date
  lastSyncAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([coinId])
  @@map("crypto_holdings")
}

enum PriceAlertDirection {
  ABOVE
  BELOW
}

/// Price alert config — persisted only. Delivery (push/email/etc.) is Phase 17.
/// Not tied to a specific holding: a user can set an alert on a coin they
/// don't yet own.
model CryptoPriceAlert {
  id          String              @id @default(cuid())
  userId      String
  coinId      String
  symbol      String
  targetPrice Decimal             @db.Decimal(20, 6)
  direction   PriceAlertDirection
  currency    String              @default("USD")
  triggeredAt DateTime?
  createdAt   DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([coinId])
  @@map("crypto_price_alerts")
}

// ─── Phase 7: Precious Metals ─────────────────────────────────────────────────

enum PreciousMetalType {
  GOLD
  SILVER
}

enum PreciousMetalSubType {
  PHYSICAL
  DIGITAL
  ETF
  JEWELLERY
}

/// Precious metal holding — linked 1:1 to an Asset row (type=GOLD or SILVER).
/// PHYSICAL/JEWELLERY are valued by weightGrams x spot price x (purity
/// fraction); DIGITAL/ETF are valued by quantity (units) x spot/unit price.
model PreciousMetalHolding {
  id             String               @id @default(cuid())
  assetId        String               @unique
  userId         String
  metalType      PreciousMetalType
  subType        PreciousMetalSubType
  /// Weight in grams — required for PHYSICAL/JEWELLERY.
  weightGrams    Decimal?             @db.Decimal(12, 3)
  /// Purity as a 0-1 fraction (e.g. 0.9167 for 22K gold, 0.999 for 24K/fine
  /// silver) — stored as a fraction (not "22K" text) so it can be used
  /// directly in the valuation calc without a lookup table.
  purityFraction Decimal?             @db.Decimal(5, 4)
  /// Units held — for DIGITAL/ETF sub-types.
  quantity       Decimal?             @db.Decimal(20, 8)
  avgBuyPrice    Decimal              @db.Decimal(20, 6)
  /// Jewellery-specific making-charge premium, flat amount in `currency`.
  makingCharge   Decimal?             @db.Decimal(20, 6)
  currency       String
  purchaseDate   DateTime?            @db.Date
  lastSyncAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("precious_metal_holdings")
}

// ─── Phase 7: Commodities ─────────────────────────────────────────────────────

enum CommodityType {
  OIL
  NATURAL_GAS
  WHEAT
  COFFEE
  CORN
  COPPER
}

/// Commodity position — linked 1:1 to an Asset row (type=COMMODITY).
/// Priced via futures-contract quotes (see CommodityPriceSyncService);
/// `unit` is a display label only ("barrels", "MMBtu", "bushels", "lbs").
model CommodityHolding {
  id            String        @id @default(cuid())
  assetId       String        @unique
  userId        String
  commodityType CommodityType
  quantity      Decimal       @db.Decimal(20, 6)
  unit          String
  avgBuyPrice   Decimal       @db.Decimal(20, 6)
  currency      String
  purchaseDate  DateTime?     @db.Date
  lastSyncAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("commodity_holdings")
}

// ─── Phase 8: Real Estate ──────────────────────────────────────────────────────

enum RealEstateSubType {
  RESIDENTIAL
  COMMERCIAL
  AGRICULTURAL
  RENTAL
  LAND
  PLOT
  APARTMENT
  VILLA
  UNDER_CONSTRUCTION
}

/// Structured real-estate details — linked 1:1 to an Asset row
/// (type=REAL_ESTATE). currentEstimate is manual, re-appraised
/// periodically (no live pricing API exists for property values).
/// lat/lng are geocoded from addressLine via Nominatim/OSM at save time.
model RealEstateDetail {
  id                    String            @id @default(cuid())
  assetId               String            @unique
  userId                String
  subType               RealEstateSubType
  addressLine           String?
  lat                   Decimal?          @db.Decimal(9, 6)
  lng                   Decimal?          @db.Decimal(9, 6)
  purchasePrice         Decimal           @db.Decimal(20, 6)
  purchaseDate          DateTime?         @db.Date
  currentEstimate       Decimal           @db.Decimal(20, 6)
  lastAppraisalDate     DateTime?         @db.Date
  /// Set only for rental-yielding properties (subType=RENTAL, or any
  /// property with a tenant) — null means "not rented."
  monthlyRentalIncome   Decimal?          @db.Decimal(20, 6)
  annualMaintenanceCost Decimal?          @db.Decimal(20, 6)
  areaValue             Decimal?          @db.Decimal(14, 2)
  areaUnit              String?
  /// Photo URLs, from the same document-upload pipeline as other assets.
  photos                Json              @default("[]")
  linkedLiabilityId     String?
  currency              String
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  asset     Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  liability Liability? @relation(fields: [linkedLiabilityId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([linkedLiabilityId])
  @@map("real_estate_details")
}

// ─── Phase 8: Manual revaluation history (collectibles, NFTs, etc.) ───────────

/// Append-only manual revaluation log — lets a user track value changes
/// over time for asset types with no pricing API (collectibles, NFTs).
model AssetRevaluation {
  id        String   @id @default(cuid())
  assetId   String
  userId    String
  value     Decimal  @db.Decimal(20, 6)
  currency  String
  note      String?
  valuedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([userId])
  @@map("asset_revaluations")
}

// ─── Phase 10: Income, Expense/Transaction Categorization, Bank Sync ──────────

/// Recurring or one-off income source discriminator
enum IncomeSourceType {
  SALARY
  BUSINESS
  RENTAL
  DIVIDENDS
  ROYALTIES
  FREELANCE
  INTEREST
  AFFILIATE
  YOUTUBE
  OTHER
}

/// How often an Income entry recurs — ONE_TIME entries are excluded from the
/// monthly-passive-income rollup.
enum IncomeFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
  ONE_TIME
}

/// A declared income source (as opposed to a single bank-synced deposit
/// Transaction) — structured amount+frequency so it can be annualized/
/// monthlyized for the dashboard's passive-income figure.
model Income {
  id           String           @id @default(cuid())
  userId       String
  sourceType   IncomeSourceType
  name         String
  amount       Decimal          @db.Decimal(20, 6)
  frequency    IncomeFrequency  @default(MONTHLY)
  currencyCode String
  startDate    DateTime?
  endDate      DateTime?
  isActive     Boolean          @default(true)
  notes        String?
  details      Json             @default("{}")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, sourceType])
  @@map("incomes")
}

/// Expense category — the auto-categorization rules engine assigns one of
/// these to every expense Transaction; OTHER is the low-confidence fallback.
enum ExpenseCategory {
  TRAVEL
  SHOPPING
  FOOD
  UTILITIES
  HEALTHCARE
  ENTERTAINMENT
  SUBSCRIPTIONS
  BILLS
  OTHER
}

/// Per-user learned categorization rule — created automatically whenever a
/// user corrects a low-confidence (OTHER/needsCategoryReview) transaction,
/// so the same merchant auto-categorizes correctly next time. The static
/// seed keyword map (code, not DB — see categorization/category-rules.ts)
/// is checked first for a merchant with no user rule yet.
model CategoryRule {
  id        String          @id @default(cuid())
  userId    String
  /// Lowercased substring matched against the transaction merchant name.
  keyword   String
  category  ExpenseCategory
  createdAt DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, keyword])
  @@index([userId])
  @@map("category_rules")
}

/// Health of a linked Plaid Item (one per connected bank/institution).
enum PlaidItemStatus {
  ACTIVE
  ERROR
  DISCONNECTED
}

/// One connected bank institution via Plaid Link. accessTokenEncrypted uses
/// the same AES-256-GCM scheme as User.mfaTotpSecret (apps/api/src/auth/crypto.util.ts).
model PlaidItem {
  id                   String          @id @default(cuid())
  userId               String
  itemId               String          @unique
  accessTokenEncrypted String
  institutionId        String?
  institutionName      String?
  status               PlaidItemStatus @default(ACTIVE)
  /// Plaid's transactionsSync cursor — lets incremental syncs resume where the last one left off.
  cursor               String?
  lastSyncedAt         DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("plaid_items")
}

// ─── Phase 14 — Market Intelligence & News ─────────────────────────────────

/// Lifecycle status of a curated IPO calendar entry.
enum IpoStatus {
  UPCOMING
  OPEN
  CLOSED
  LISTED
  WITHDRAWN
}

/// A manually curated IPO calendar entry. No free, reliably-callable, global
/// IPO-calendar API was found (confirmed: NASDAQ/NSE/BSE each publish IPO
/// data on their own websites with no stable free API; paid providers exist
/// but weren't in budget for this phase) — per the phase spec, this is an
/// honest manual-entry feature, not a live sync, and the frontend widget
/// must say so explicitly rather than implying live data.
model IpoListing {
  id             String    @id @default(cuid())
  companyName    String
  exchange       String // e.g. "NSE", "BSE", "NASDAQ", "NYSE"
  expectedDate   DateTime? @db.Date
  priceRangeMin  Decimal?  @db.Decimal(20, 2)
  priceRangeMax  Decimal?  @db.Decimal(20, 2)
  currency       String    @default("USD")
  status         IpoStatus @default(UPCOMING)
  notes          String?
  createdByUserId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  createdBy User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([expectedDate])
  @@index([status])
  @@map("ipo_listings")
}

// ─── Phase 15: Tax Center ──────────────────────────────────────────────────
//
// No lot-level cost-basis tracking existed anywhere before this phase:
// StockHolding/MutualFundHolding/CryptoHolding each store only an aggregate
// quantity + weighted-average buy price + a single purchase date, and
// nothing in the stocks/mutual-funds/crypto modules wrote a Transaction
// record on buy/sell. TaxLot/TaxLotDisposal below are new, real per-lot
// records — FIFO-consumed on disposal, so capital-gains math is a real
// query over real rows, not a formula guessing from an aggregate.
//
// Pre-existing holdings (created before this phase) have no real lot
// history to backfill from — TaxLotService creates exactly ONE synthetic
// lot per existing holding, sized to its full current quantity, dated at
// its `purchaseDate` (or `createdAt` if that's null), costed at its
// `avgBuyPrice`/`avgNAV`. This is explicitly flagged `isBackfillEstimate:
// true` and surfaced as such in every report/UI that touches it — it is
// NOT precise per-purchase history, just the best available honest
// approximation, exactly like this repo's other documented placeholders
// (Phase 2's /50000 divisor, Phase 14's STATIC badges). Going forward, real
// buy/sell activity recorded through TaxController creates real lots.
//
// Dividend income deliberately does NOT get a new table: `Income` already
// has `sourceType: DIVIDENDS` (unused until now) — a dividend is recorded
// as a ONE_TIME Income row (per PROJECT_CONTEXT's reuse principle), with
// `details: { holdingType, ticker }` linking it to the paying security so
// tax reports can group by holding. See apps/api/src/tax/dividend-tax.service.ts.

enum TaxHoldingType {
  STOCK
  MUTUAL_FUND
  CRYPTO
}

enum TaxLotStatus {
  OPEN
  PARTIALLY_DISPOSED
  CLOSED
}

enum CapitalGainsTerm {
  SHORT
  LONG
}

/// One real acquisition lot (a single buy) for a stock/mutual-fund/crypto
/// holding. `remainingQuantity` is decremented by FIFO disposals; the lot
/// is fully consumed when it reaches 0.
model TaxLot {
  id                 String         @id @default(cuid())
  userId             String
  holdingType        TaxHoldingType
  /// FK to the live Asset row, where one still exists — nullable so a lot
  /// survives if the holding itself is later deleted (tax history must
  /// outlive the holding it came from).
  assetId            String?
  /// Ticker (stocks), coinId (crypto), or schemeCode (mutual funds) — the
  /// same identifying string PriceSyncService/CryptoMarketService/mutual
  /// funds' MFAPI integration already key prices by, so current-price
  /// lookups for unrealized gain/loss reuse those services directly.
  ticker             String
  displayName        String
  quantity           Decimal        @db.Decimal(28, 10)
  remainingQuantity  Decimal        @db.Decimal(28, 10)
  costBasisPerUnit   Decimal        @db.Decimal(20, 6)
  costBasisCurrency  String
  acquiredAt         DateTime
  /// True only for the single synthetic lot backfilled from a pre-existing
  /// holding's aggregate avgBuyPrice/purchaseDate — see file header comment.
  isBackfillEstimate Boolean        @default(false)
  status             TaxLotStatus   @default(OPEN)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset     Asset?           @relation(fields: [assetId], references: [id], onDelete: SetNull)
  disposals TaxLotDisposal[]

  @@index([userId])
  @@index([userId, holdingType, ticker])
  @@index([userId, status])
  @@map("tax_lots")
}

/// One disposal (sell) event, consuming quantity from a specific TaxLot.
/// A single real-world sell that spans multiple lots (FIFO) produces
/// multiple TaxLotDisposal rows, one per lot consumed.
model TaxLotDisposal {
  id                String           @id @default(cuid())
  taxLotId          String
  userId            String
  quantity          Decimal          @db.Decimal(28, 10)
  proceedsPerUnit   Decimal          @db.Decimal(20, 6)
  /// Assumed equal to the lot's costBasisCurrency — cross-currency disposals
  /// are out of scope for this phase (documented, not silently wrong: see
  /// CapitalGainsService.disposeLot which throws rather than mixing currencies).
  proceedsCurrency  String
  disposedAt        DateTime
  holdingPeriodDays Int
  term              CapitalGainsTerm
  realizedGainLoss  Decimal          @db.Decimal(20, 6)
  notes             String?
  createdAt         DateTime         @default(now())

  taxLot TaxLot @relation(fields: [taxLotId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, disposedAt])
  @@index([taxLotId])
  @@map("tax_lot_disposals")
}

// ─── Phase 15 extension: ITR document upload & analysis ──────────────────────
// A user-uploaded income-tax-return document (India ITR-1/2/3/4, PDF or
// image). `parsedData` is a STAGING area only — see ItrService header
// comment: nothing here is ever written into TaxLot/TaxLotDisposal/Income.
// `confirmedAt` marks that the user has reviewed/corrected the parse; the
// document and its parsedData are used only for the cross-check comparison
// against CapitalGainsService/Income, never to mutate financial records.

enum ItrExtractionStatus {
  PENDING
  PROCESSING
  EXTRACTED_AWAITING_REVIEW
  CONFIRMED
  FAILED
}

enum ItrExtractionMethod {
  PDF_TEXT
  OCR
}

model ItrDocument {
  id                String              @id @default(cuid())
  userId            String
  assessmentYear    String // e.g. "2025-26" — the AY the ITR was filed for
  storagePath       String // path within the private "tax-documents" Supabase Storage bucket
  mimeType          String
  originalFilename  String
  extractionStatus  ItrExtractionStatus @default(PENDING)
  extractionMethod  ItrExtractionMethod?
  /// 0-1 overall confidence (min of per-field confidences); per-field
  /// confidence/needsReview flags live inside parsedData itself.
  confidenceScore   Decimal?            @db.Decimal(4, 3)
  /// Staging area for extracted fields (ParsedItrData shape, shared-types).
  /// NEVER read by CapitalGainsService/DividendTaxService/TaxLotService —
  /// grep confirms no write path from here into any other financial table.
  parsedData        Json                @default("{}")
  errorMessage      String?
  reviewedAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, assessmentYear])
  @@map("itr_documents")
}

// ─── Phase 16: zero-knowledge encrypted document vault ───────────────────────
// Architecturally distinct from asset-documents/tax-documents (Phase 1/15):
// those upload PLAINTEXT over TLS — the server/Supabase Storage sees file
// content (Supabase-managed at-rest encryption only). Here the browser
// encrypts with AES-256-GCM (packages/shared-types/src/vault/crypto.ts)
// BEFORE any byte leaves the client — this table and the vault-documents
// bucket only ever hold/see ciphertext. mimeType/fileSizeBytes are stored
// in the clear (low-sensitivity technical metadata, same as ItrDocument);
// originalFilename is NOT stored in the clear (a filename like
// "Aadhaar_1234.pdf" can itself leak sensitive info) — it's AES-GCM
// encrypted with the same document key and decrypted client-side for
// display, same as the file content.

enum VaultDocumentCategory {
  PAN
  AADHAAR
  PASSPORT
  INSURANCE
  PROPERTY_DOCUMENTS
  INVESTMENT_STATEMENTS
  TAX_RETURNS
}

model VaultDocument {
  id       String                @id @default(cuid())
  userId   String
  category VaultDocumentCategory

  /// Path within the private "vault-documents" Supabase Storage bucket.
  /// Deliberately a random id, NOT a sanitized-original-filename path like
  /// asset-documents/tax-documents use — the plaintext filename must not
  /// appear anywhere server-visible, including the storage path itself.
  storagePath String

  /// AES-GCM ciphertext of the original filename (base64), decrypted
  /// client-side only. encryptedFilenameIv is that ciphertext's own nonce
  /// (distinct from `iv`, the file content's nonce — AES-GCM requires a
  /// fresh IV per encryption, never reused across two ciphertexts).
  encryptedFilename   String
  encryptedFilenameIv String

  mimeType      String
  fileSizeBytes Int
  /// AES-GCM nonce (base64) for the file CONTENT ciphertext stored in
  /// vault-documents at `storagePath`. Not secret — safe alongside ciphertext.
  iv String

  linkedAssetId String?
  createdAt     DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset Asset? @relation(fields: [linkedAssetId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, category])
  @@map("vault_documents")
}

// ─── Phase 17: Alerts & Notifications ──────────────────────────────────────

/// Price alert config for stocks — mirrors CryptoPriceAlert exactly (Phase 6's
/// model/pattern). Persisted since Phase 4 conceptually should have had this;
/// added now because Phase 17 is the first thing that actually evaluates it.
model StockPriceAlert {
  id          String              @id @default(cuid())
  userId      String
  ticker      String
  exchange    String
  targetPrice Decimal             @db.Decimal(20, 6)
  direction   PriceAlertDirection
  currency    String              @default("USD")
  triggeredAt DateTime?
  createdAt   DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([ticker, exchange])
  @@map("stock_price_alerts")
}

enum NotificationType {
  MARKET_CRASH
  DIVIDEND_RECEIVED
  LOAN_DUE
  SIP_DUE
  STOCK_PRICE_ALERT
  CRYPTO_PRICE_ALERT
  PROPERTY_PRICE_CHANGE
}

enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
}

/// One row per delivered (or attempted) alert event. Idempotency is the
/// point of this model: `sourceEntityId` + `triggerBucket` together identify
/// "this specific real-world event, from this evaluator run onward" so a
/// BullMQ job that fires twice (retry, overlapping schedules, etc.) can
/// never create two rows for the same thing — see the unique constraint.
/// `triggerBucket` is "ONCE" for one-shot alerts (a price target either
/// hasn't fired yet or has — CryptoPriceAlert.triggeredAt/StockPriceAlert.
/// triggeredAt is the actual guard there, this is a defense-in-depth second
/// guard) and a date string (yyyy-mm-dd) for alerts that can legitimately
/// re-fire on a later day (market crash, an EMI still "approaching" tomorrow).
model Notification {
  id              String              @id @default(cuid())
  userId          String
  type            NotificationType
  title           String
  body            String
  /// Structured context for the frontend (ticker, amount, delta%, etc.) —
  /// never raw enough to need i18n by itself; title/body are pre-rendered.
  data            Json                @default("{}")
  sourceEntityId  String
  triggerBucket   String
  /// Per-channel attempt/outcome, e.g. {"IN_APP":"SENT","PUSH":"SKIPPED_BY_PREFERENCE","EMAIL":"SKIPPED_NO_CREDENTIALS"}.
  /// This is the evidence the "disabling one channel only suppresses that
  /// channel" acceptance criterion is tested against.
  deliveryResult  Json                @default("{}")
  read            Boolean             @default(false)
  readAt          DateTime?
  createdAt       DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, sourceEntityId, triggerBucket])
  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// Per-(user, alertType) channel toggles. A missing row for a given type
/// means "use the default" (in-app on, push/email off) — see
/// NotificationPreferenceService.DEFAULTS.
model NotificationPreference {
  id           String           @id @default(cuid())
  userId       String
  alertType    NotificationType
  inAppEnabled Boolean          @default(true)
  pushEnabled  Boolean          @default(false)
  emailEnabled Boolean          @default(false)
  updatedAt    DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, alertType])
  @@map("notification_preferences")
}

/// One FCM registration token per browser/device a user has granted push
/// permission on. A user can have several (multiple browsers); tokens are
/// opaque and rotate on Firebase's own schedule, so this is a pure cache —
/// safe to delete and have the client re-register.
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

// ─── Phase 19: AI Layer (RAG, Chat, Reports, Suggestions) ──────────────────

enum AiSourceType {
  ASSET
  LIABILITY
  TRANSACTION
  GOAL
  ANALYTICS_SNAPSHOT
  INCOME
}

/// One row per indexed, embeddable chunk of a user's own data — the whole
/// point of RAG here: the LLM answers grounded in these real rows, not its
/// own training-data guesses about "a typical portfolio." `embedding` is a
/// pgvector column (768-dim, matching Ollama's nomic-embed-text) — Prisma
/// has no native vector type, so it's declared `Unsupported` and written/
/// read via raw SQL ($queryRaw/$executeRaw) in EmbeddingRepository, never
/// through the generated client's normal find/create methods.
model PortfolioEmbedding {
  id         String       @id @default(cuid())
  userId     String
  sourceType AiSourceType
  sourceId   String
  /// The natural-language chunk that was actually embedded — kept alongside
  /// the vector so retrieval can return real quoted text, not just an id.
  content    String
  embedding  Unsupported("vector(768)")?
  updatedAt  DateTime     @updatedAt
  createdAt  DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceType, sourceId])
  @@index([userId])
  @@map("portfolio_embeddings")
}

model AiConversation {
  id        String      @id @default(cuid())
  userId    String
  title     String      @default("New chat")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([userId])
  @@map("ai_conversations")
}

enum AiMessageRole {
  USER
  ASSISTANT
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           AiMessageRole
  content        String
  /// Which indexed rows (if any) were retrieved and fed to the LLM as
  /// grounding context for this answer — the citation trail, not a guess.
  ragSources     Json           @default("[]")
  /// Honest record of which model actually produced this — e.g.
  /// "claude-sonnet-5" or "ollama:gemma4" (fallback) — never hidden.
  modelUsed      String?
  createdAt      DateTime       @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

enum AiReportType {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

/// The underlying numbers (`computedData`) always come from real
/// NetWorthSnapshot/analytics queries — the LLM (or, honestly, a template
/// fallback when no LLM is configured) only supplies the natural-language
/// framing in `narrative`, never the figures themselves.
model AiReport {
  id             String       @id @default(cuid())
  userId         String
  type           AiReportType
  periodStart    DateTime
  periodEnd      DateTime
  computedData   Json
  narrative      String
  isLLMGenerated Boolean      @default(false)
  modelUsed      String?
  createdAt      DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, periodStart])
  @@index([userId, type])
  @@map("ai_reports")
}

enum AiSuggestionType {
  SELL
  BUY
  REBALANCE
  TAX_HARVEST
  INCREASE_SIP
}

enum AiSuggestionStatus {
  ACTIVE
  DISMISSED
  ACTED_ON
}

/// A structured, explainable suggestion — never just chat prose. `dataPoint`
/// holds the exact holding/ratio/threshold that triggered it (e.g.
/// {"ticker":"AAPL","currentPrice":150,"costBasis":200,"lossAmount":5000}
/// for a TAX_HARVEST card) so the UI can always show its receipt, not a
/// black-box claim. `dedupeKey` is the idempotency guard (same pattern as
/// Phase 17's Notification unique constraint) so re-running the rules
/// engine doesn't spam duplicate cards for the same underlying condition.
model AiSuggestion {
  id          String             @id @default(cuid())
  userId      String
  type        AiSuggestionType
  title       String
  description String
  dataPoint   Json
  dedupeKey   String
  status      AiSuggestionStatus @default(ACTIVE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, status])
  @@map("ai_suggestions")
}
