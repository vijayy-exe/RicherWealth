// RicherWealth Prisma Schema — Phase 5: Mutual Funds, ETFs & Bonds (extends Phase 4)
// Conventions:
//   - UUIDs for all primary keys (cuid for URL-safety)
//   - All monetary values store an explicit currencyCode; never convert at write-time
//   - JSONB `details` column on Asset/Liability for type-specific fields
//   - Soft-delete pattern: deletedAt timestamp, never hard-delete financial records

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, uuidOssp(map: "uuid-ossp")]
}

// ─── Enums ────────────────────────────────────────────────────────────────────

/// Phase 5: Bond type discriminator
enum BondType {
  GOVT
  CORPORATE
  MUNICIPAL
  SGB
}

/// Investment mode for mutual fund holdings
enum MfInvestmentType {
  SIP
  LUMPSUM
}

/// Asset top-level category discriminator
enum AssetType {
  CASH
  FIXED_DEPOSIT
  STOCK
  MUTUAL_FUND
  ETF
  BOND
  CRYPTO
  GOLD
  SILVER
  COMMODITY
  REAL_ESTATE
  VEHICLE
  COLLECTIBLE
  NFT
  BUSINESS_EQUITY
  PRIVATE_EQUITY
  ANGEL_INVESTMENT
  REIT
  P2P_LENDING
  RETIREMENT_ACCOUNT
  INSURANCE
  FOREX
  OTHER
}

/// Liability type discriminator
enum LiabilityType {
  MORTGAGE
  CAR_LOAN
  EDUCATION_LOAN
  PERSONAL_LOAN
  CREDIT_CARD
  OTHER
}

/// Household role for RBAC
enum HouseholdRole {
  OWNER
  MEMBER
  VIEWER
}

/// Passkey/authenticator device type
enum PasskeyDeviceType {
  SINGLE_DEVICE
  MULTI_DEVICE
}

// ─── Core Models ──────────────────────────────────────────────────────────────

/// Platform user — synced from Supabase Auth on first login
model User {
  id                  String    @id @default(cuid())
  /// Supabase auth UID — links JWT sub claim to this row
  supabaseId          String    @unique
  email               String    @unique
  name                String?
  avatarUrl           String?
  baseCurrency        String    @default("USD")   // ISO 4217
  mfaEnabled          Boolean   @default(false)
  /// TOTP secret (encrypted at application layer before storing)
  mfaTotpSecret       String?
  onboardingCompleted Boolean   @default(false)
  /// Stores the "what do you want to track" quick-pick selections
  trackingPreferences Json      @default("[]")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  // Relations
  assets               Asset[]
  liabilities          Liability[]
  transactions         Transaction[]
  householdMemberships HouseholdMember[]
  sessions             Session[]
  passkeys             Passkey[]
  netWorthSnapshots    NetWorthSnapshot[]
  stockHoldings        StockHolding[]
  watchlists           Watchlist[]
  // Phase 5
  mutualFundHoldings   MutualFundHolding[]
  etfHoldings          EtfHolding[]
  bondHoldings         BondHolding[]
  // Phase 6
  cryptoHoldings       CryptoHolding[]
  cryptoPriceAlerts    CryptoPriceAlert[]
  // Phase 7
  preciousMetalHoldings PreciousMetalHolding[]
  commodityHoldings     CommodityHolding[]
  // Phase 8
  realEstateDetails     RealEstateDetail[]
  assetRevaluations     AssetRevaluation[]

  @@index([email])
  @@index([supabaseId])
  @@map("users")
}

/// Active user session — tracked so users can revoke them
model Session {
  id          String    @id @default(cuid())
  userId      String
  /// Supabase session ID for cross-reference
  supabaseSessionId String?  @unique
  deviceName  String?   // e.g. "Chrome on macOS"
  deviceType  String?   // "desktop" | "mobile" | "tablet"
  ipAddress   String?
  userAgent   String?
  lastSeenAt  DateTime  @default(now())
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([revokedAt])
  @@map("sessions")
}

/// WebAuthn passkey credential
model Passkey {
  id             String           @id @default(cuid())
  userId         String
  /// Raw credential ID from WebAuthn (base64url encoded)
  credentialId   String           @unique
  /// COSE public key (base64url encoded)
  publicKey      String
  /// Signature counter — must be monotonically increasing to detect cloning
  counter        BigInt           @default(0)
  deviceType     PasskeyDeviceType @default(MULTI_DEVICE)
  /// Human-readable label set by the user
  name           String           @default("My Passkey")
  backedUp       Boolean          @default(false)
  transports     String[]
  createdAt      DateTime         @default(now())
  lastUsedAt     DateTime?

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

/// Family / shared household (for Family Office mode)
model Household {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   HouseholdMember[]

  @@map("households")
}

/// Junction: user ↔ household with role
model HouseholdMember {
  id          String        @id @default(cuid())
  userId      String
  householdId String
  role        HouseholdRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([userId, householdId])
  @@map("household_members")
}

/// Generic asset record — every asset class is a row here.
model Asset {
  id           String    @id @default(cuid())
  userId       String
  type         AssetType
  name         String
  currentValue Decimal   @db.Decimal(20, 6)
  currencyCode String
  details      Json      @default("{}")
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  stockHolding      StockHolding?
  // Phase 5
  mutualFundHolding MutualFundHolding?
  etfHolding        EtfHolding?
  bondHolding       BondHolding?
  // Phase 6
  cryptoHolding     CryptoHolding?
  // Phase 7
  preciousMetalHolding PreciousMetalHolding?
  commodityHolding     CommodityHolding?
  // Phase 8
  realEstateDetail     RealEstateDetail?
  revaluations         AssetRevaluation[]

  @@index([userId])
  @@index([userId, type])
  @@index([deletedAt])
  @@map("assets")
}

/// Liability (loan/debt) record
model Liability {
  id               String        @id @default(cuid())
  userId           String
  type             LiabilityType
  name             String
  principalAmount  Decimal       @db.Decimal(20, 6)
  remainingBalance Decimal       @db.Decimal(20, 6)
  interestRate     Decimal       @db.Decimal(8, 4)
  currencyCode     String
  emiAmount        Decimal?      @db.Decimal(20, 6)
  dueDate          DateTime?
  startDate        DateTime?
  maturityDate     DateTime?
  details          Json          @default("{}")
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions     Transaction[]
  linkedRealEstate RealEstateDetail[]

  @@index([userId])
  @@index([userId, type])
  @@map("liabilities")
}

/// Financial transaction — append-only ledger
model Transaction {
  id           String   @id @default(cuid())
  userId       String
  assetId      String?
  liabilityId  String?
  type         String
  amount       Decimal  @db.Decimal(20, 6)
  currencyCode String
  quantity     Decimal? @db.Decimal(20, 8)
  pricePerUnit Decimal? @db.Decimal(20, 6)
  date         DateTime
  category     String?
  merchant     String?
  description  String?
  source       String   @default("manual")
  details      Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset        Asset?      @relation(fields: [assetId], references: [id])
  liability    Liability?  @relation(fields: [liabilityId], references: [id])

  @@index([userId])
  @@index([userId, date])
  @@index([userId, type])
  @@index([assetId])
  @@map("transactions")
}

/// Daily net-worth snapshot — written by nightly cron, used for trend charts and delta calculations
model NetWorthSnapshot {
  id               String   @id @default(cuid())
  userId           String
  totalAssets      Decimal  @db.Decimal(24, 6)
  totalLiabilities Decimal  @db.Decimal(24, 6)
  netWorth         Decimal  @db.Decimal(24, 6)
  baseCurrency     String
  snapshotDate     DateTime @db.Date  // date only — one row per user per day

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, snapshotDate])
  @@index([userId, snapshotDate])
  @@map("net_worth_snapshots")
}

/// Forex rate cache — refreshed hourly by ForexService
model ForexRate {
  id        String   @id @default(cuid())
  fromCode  String   // ISO 4217
  toCode    String   // ISO 4217
  rate      Decimal  @db.Decimal(20, 8)
  fetchedAt DateTime @default(now())

  @@unique([fromCode, toCode])
  @@index([fromCode, toCode])
  @@map("forex_rates")
}

// ─── Phase 4: Stock Holdings & Price Sync ─────────────────────────────────────

/// Stock holding — linked 1:1 to a generic Asset row (type=STOCK)
/// Asset.currentValue is kept in sync whenever price updates.
model StockHolding {
  id           String   @id @default(cuid())
  assetId      String   @unique            // FK → Asset
  userId       String
  ticker       String                      // e.g. "AAPL", "RELIANCE"
  exchange     String                      // e.g. "NASDAQ", "NSE", "BSE", "NYSE", "LSE", "HKEX"
  quantity     Decimal  @db.Decimal(20, 8) // supports fractional shares
  avgBuyPrice  Decimal  @db.Decimal(20, 6)
  currency     String                      // currency of avgBuyPrice
  purchaseDate DateTime?
  lastSyncAt   DateTime?                   // when price was last fetched
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  asset        Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([ticker, exchange])
  @@map("stock_holdings")
}

/// Latest price snapshot per ticker — written by PriceSyncService
model StockPrice {
  id            String   @id @default(cuid())
  ticker        String
  exchange      String
  price         Decimal  @db.Decimal(20, 6)
  previousClose Decimal? @db.Decimal(20, 6)
  dayHigh       Decimal? @db.Decimal(20, 6)
  dayLow        Decimal? @db.Decimal(20, 6)
  volume        BigInt?
  pe            Decimal? @db.Decimal(12, 4) // P/E ratio from provider
  eps           Decimal? @db.Decimal(12, 4) // Earnings per share
  bvps          Decimal? @db.Decimal(12, 4) // Book value per share (for Graham)
  dividendYield Decimal? @db.Decimal(8, 4)  // annual yield %
  currency      String                       // currency of price
  provider      String                       // "alpha_vantage" | "finnhub" | "twelve_data"
  fetchedAt     DateTime @default(now())

  @@unique([ticker, exchange])
  @@index([ticker, exchange])
  @@map("stock_prices")
}

/// User-created watchlist (can have multiple)
model Watchlist {
  id        String          @id @default(cuid())
  userId    String
  name      String          @default("My Watchlist")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WatchlistItem[]

  @@index([userId])
  @@map("watchlists")
}

/// Individual ticker in a watchlist
model WatchlistItem {
  id          String    @id @default(cuid())
  watchlistId String
  ticker      String
  exchange    String
  addedAt     DateTime  @default(now())

  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, ticker, exchange])
  @@index([watchlistId])
  @@map("watchlist_items")
}

// ─── Phase 5: Mutual Funds ────────────────────────────────────────────────────

/// Mutual fund holding — linked 1:1 to an Asset row (type=MUTUAL_FUND)
/// Asset.currentValue = unitsHeld × latestNAV, kept in sync by nav-sync job.
model MutualFundHolding {
  id             String          @id @default(cuid())
  assetId        String          @unique            // FK → Asset
  userId         String
  /// MFAPI.in scheme code (numeric string, e.g. "120503" for Axis Bluechip)
  schemeCode     String
  fundName       String
  investmentType MfInvestmentType @default(LUMPSUM)
  unitsHeld      Decimal         @db.Decimal(20, 8)
  avgNAV         Decimal         @db.Decimal(20, 6)  // weighted avg of all purchases
  /// Expense ratio % (user-entered or looked up; optional)
  expenseRatio   Decimal?        @db.Decimal(6, 4)
  isin           String?
  lastNavSyncAt  DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  asset          Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sipInstallments SipInstallment[]

  @@index([userId])
  @@index([schemeCode])
  @@map("mutual_fund_holdings")
}

/// Individual SIP installment — each is a distinct cash-flow for XIRR
model SipInstallment {
  id                  String           @id @default(cuid())
  mutualFundHoldingId String
  /// Amount invested in this installment (in fund currency)
  amount              Decimal          @db.Decimal(20, 6)
  /// Units allotted for this installment
  units               Decimal          @db.Decimal(20, 8)
  /// NAV at time of purchase
  nav                 Decimal          @db.Decimal(20, 6)
  date                DateTime         @db.Date
  createdAt           DateTime         @default(now())

  mutualFundHolding   MutualFundHolding @relation(fields: [mutualFundHoldingId], references: [id], onDelete: Cascade)

  @@index([mutualFundHoldingId])
  @@index([date])
  @@map("sip_installments")
}

/// Historical NAV data from MFAPI.in — one row per scheme per day
model NavHistory {
  id         String   @id @default(cuid())
  schemeCode String
  date       DateTime @db.Date
  nav        Decimal  @db.Decimal(20, 6)
  createdAt  DateTime @default(now())

  @@unique([schemeCode, date])
  @@index([schemeCode, date])
  @@map("nav_history")
}

// ─── Phase 5: ETFs ────────────────────────────────────────────────────────────

/// ETF holding — linked 1:1 to an Asset row (type=ETF)
/// Reuses the stock price pipeline (PriceSyncService) since ETFs trade like stocks.
model EtfHolding {
  id           String   @id @default(cuid())
  assetId      String   @unique            // FK → Asset
  userId       String
  ticker       String                      // e.g. "NIFTYBEES", "SPY"
  exchange     String                      // e.g. "NSE", "NASDAQ"
  unitsHeld    Decimal  @db.Decimal(20, 8)
  avgBuyPrice  Decimal  @db.Decimal(20, 6)
  currency     String
  purchaseDate DateTime?
  lastSyncAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  asset        Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([ticker, exchange])
  @@map("etf_holdings")
}

// ─── Phase 5: Bonds ───────────────────────────────────────────────────────────

/// Bond holding — linked 1:1 to an Asset row (type=BOND)
/// currentValue = quantityHeld × faceValue (book value; market pricing deferred to Phase 6)
model BondHolding {
  id            String    @id @default(cuid())
  assetId       String    @unique           // FK → Asset
  userId        String
  issuer        String
  bondType      BondType  @default(CORPORATE)
  faceValue     Decimal   @db.Decimal(20, 6)
  couponRate    Decimal   @db.Decimal(8, 4) // annual % e.g. 7.25
  maturityDate  DateTime  @db.Date
  quantityHeld  Int                          // number of bonds
  purchaseDate  DateTime? @db.Date
  purchasePrice Decimal?  @db.Decimal(20, 6) // price paid per bond
  isin          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  asset         Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([maturityDate])
  @@map("bond_holdings")
}

// ─── Phase 6: Crypto ──────────────────────────────────────────────────────────

/// Crypto holding — linked 1:1 to an Asset row (type=CRYPTO).
/// walletAddress is optional, read-only tracking metadata only — never a
/// private key or seed phrase, and never requested/stored.
model CryptoHolding {
  id            String    @id @default(cuid())
  assetId       String    @unique           // FK → Asset
  userId        String
  /// CoinGecko coin id, e.g. "bitcoin", "ethereum", "solana"
  coinId        String
  symbol        String                       // e.g. "BTC" (denormalized for display)
  name          String                       // e.g. "Bitcoin" (denormalized for display)
  quantity      Decimal   @db.Decimal(28, 10) // crypto needs far more decimal precision than fiat
  avgBuyPrice   Decimal   @db.Decimal(20, 6)
  currency      String
  /// Public wallet address for read-only reference only (e.g. to cross-check
  /// holdings on a block explorer). No private keys or seed phrases.
  walletAddress String?
  purchaseDate  DateTime? @db.Date
  lastSyncAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  asset         Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([coinId])
  @@map("crypto_holdings")
}

enum PriceAlertDirection {
  ABOVE
  BELOW
}

/// Price alert config — persisted only. Delivery (push/email/etc.) is Phase 17.
/// Not tied to a specific holding: a user can set an alert on a coin they
/// don't yet own.
model CryptoPriceAlert {
  id          String              @id @default(cuid())
  userId      String
  coinId      String
  symbol      String
  targetPrice Decimal             @db.Decimal(20, 6)
  direction   PriceAlertDirection
  currency    String              @default("USD")
  triggeredAt DateTime?
  createdAt   DateTime            @default(now())

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([coinId])
  @@map("crypto_price_alerts")
}

// ─── Phase 7: Precious Metals ─────────────────────────────────────────────────

enum PreciousMetalType {
  GOLD
  SILVER
}

enum PreciousMetalSubType {
  PHYSICAL
  DIGITAL
  ETF
  JEWELLERY
}

/// Precious metal holding — linked 1:1 to an Asset row (type=GOLD or SILVER).
/// PHYSICAL/JEWELLERY are valued by weightGrams x spot price x (purity
/// fraction); DIGITAL/ETF are valued by quantity (units) x spot/unit price.
model PreciousMetalHolding {
  id           String                @id @default(cuid())
  assetId      String                @unique
  userId       String
  metalType    PreciousMetalType
  subType      PreciousMetalSubType
  /// Weight in grams — required for PHYSICAL/JEWELLERY.
  weightGrams  Decimal?              @db.Decimal(12, 3)
  /// Purity as a 0-1 fraction (e.g. 0.9167 for 22K gold, 0.999 for 24K/fine
  /// silver) — stored as a fraction (not "22K" text) so it can be used
  /// directly in the valuation calc without a lookup table.
  purityFraction Decimal?            @db.Decimal(5, 4)
  /// Units held — for DIGITAL/ETF sub-types.
  quantity     Decimal?              @db.Decimal(20, 8)
  avgBuyPrice  Decimal               @db.Decimal(20, 6)
  /// Jewellery-specific making-charge premium, flat amount in `currency`.
  makingCharge Decimal?              @db.Decimal(20, 6)
  currency     String
  purchaseDate DateTime?             @db.Date
  lastSyncAt   DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  asset        Asset                 @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("precious_metal_holdings")
}

// ─── Phase 7: Commodities ─────────────────────────────────────────────────────

enum CommodityType {
  OIL
  NATURAL_GAS
  WHEAT
  COFFEE
  CORN
  COPPER
}

/// Commodity position — linked 1:1 to an Asset row (type=COMMODITY).
/// Priced via futures-contract quotes (see CommodityPriceSyncService);
/// `unit` is a display label only ("barrels", "MMBtu", "bushels", "lbs").
model CommodityHolding {
  id            String        @id @default(cuid())
  assetId       String        @unique
  userId        String
  commodityType CommodityType
  quantity      Decimal       @db.Decimal(20, 6)
  unit          String
  avgBuyPrice   Decimal       @db.Decimal(20, 6)
  currency      String
  purchaseDate  DateTime?     @db.Date
  lastSyncAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  asset         Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("commodity_holdings")
}

// ─── Phase 8: Real Estate ──────────────────────────────────────────────────────

enum RealEstateSubType {
  RESIDENTIAL
  COMMERCIAL
  AGRICULTURAL
  RENTAL
  LAND
  PLOT
  APARTMENT
  VILLA
  UNDER_CONSTRUCTION
}

/// Structured real-estate details — linked 1:1 to an Asset row
/// (type=REAL_ESTATE). currentEstimate is manual, re-appraised
/// periodically (no live pricing API exists for property values).
/// lat/lng are geocoded from addressLine via Nominatim/OSM at save time.
model RealEstateDetail {
  id                    String            @id @default(cuid())
  assetId               String            @unique
  userId                String
  subType               RealEstateSubType
  addressLine           String?
  lat                   Decimal?          @db.Decimal(9, 6)
  lng                   Decimal?          @db.Decimal(9, 6)
  purchasePrice         Decimal           @db.Decimal(20, 6)
  purchaseDate          DateTime?         @db.Date
  currentEstimate       Decimal           @db.Decimal(20, 6)
  lastAppraisalDate     DateTime?         @db.Date
  /// Set only for rental-yielding properties (subType=RENTAL, or any
  /// property with a tenant) — null means "not rented."
  monthlyRentalIncome   Decimal?          @db.Decimal(20, 6)
  annualMaintenanceCost Decimal?          @db.Decimal(20, 6)
  areaValue             Decimal?          @db.Decimal(14, 2)
  areaUnit              String?
  /// Photo URLs, from the same document-upload pipeline as other assets.
  photos                Json              @default("[]")
  linkedLiabilityId     String?
  currency              String
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  asset     Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  liability Liability? @relation(fields: [linkedLiabilityId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([linkedLiabilityId])
  @@map("real_estate_details")
}

// ─── Phase 8: Manual revaluation history (collectibles, NFTs, etc.) ───────────

/// Append-only manual revaluation log — lets a user track value changes
/// over time for asset types with no pricing API (collectibles, NFTs).
model AssetRevaluation {
  id        String   @id @default(cuid())
  assetId   String
  userId    String
  value     Decimal  @db.Decimal(20, 6)
  currency  String
  note      String?
  valuedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([userId])
  @@map("asset_revaluations")
}
