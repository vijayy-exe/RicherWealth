# Environment variables — copy to .env and fill in real values
# Never commit .env to version control

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://richerwealth:richerwealth@localhost:5432/richerwealth?schema=public"

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Auth ─────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── API ──────────────────────────────────────────────────────────────────────
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── Quant microservice ───────────────────────────────────────────────────────
QUANT_API_URL=http://localhost:8000

# ─── Market data providers (free tiers) ──────────────────────────────────────
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
COINGECKO_API_KEY=           # optional — demo key works without
GOLDAPI_API_KEY=
NEWSAPI_KEY=

# ─── AI providers ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ─── Storage ──────────────────────────────────────────────────────────────────
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=richerwealth-docs

# ─── Email ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=

# ─── FCM (Push notifications) ─────────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
