# Environment variables — copy to .env and fill in real values
# Never commit .env to version control

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://richerwealth:richerwealth@localhost:5432/richerwealth?schema=public"

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Auth ─────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte key, hex-encoded (64 chars) — generate with `openssl rand -hex 32`.
# Encrypts mfaTotpSecret at rest (AES-256-GCM). Required for MFA to work.
MFA_ENCRYPTION_KEY=

# WebAuthn passkeys — RP_ID is the frontend's bare domain (no scheme/port),
# RP_ORIGIN is its full origin. Both default to local dev values if unset.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:3000

# ─── API ──────────────────────────────────────────────────────────────────────
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── Quant microservice ───────────────────────────────────────────────────────
QUANT_API_URL=http://localhost:8000

# ─── Market data providers (free tiers) ──────────────────────────────────────
# NOTE: the app reads ALPHA_VANTAGE_KEY (not ALPHA_VANTAGE_API_KEY) — fixed
# here in Phase 11 after noticing the mismatch; the real .env already had
# the correct name, this file just didn't match it.
ALPHA_VANTAGE_KEY=
FINNHUB_KEY=
TWELVE_DATA_KEY=
COINGECKO_API_KEY=           # optional — demo key works without
GOLDAPI_API_KEY=
# Phase 14 Market Intelligence news feed — free key at https://newsapi.org/register.
# Preferred fallback if GNEWS_API_KEY is unset. If neither is set, the news
# feed falls back to Finnhub general news only (FINNHUB_KEY, already above).
NEWSAPI_KEY=
# Phase 14 Market Intelligence news feed — preferred primary source (more
# production-safe free-tier ToS). Free key at https://gnews.io/register.
GNEWS_API_KEY=
# Free, instant-signup key at https://fred.stlouisfed.org/docs/api/api_key.html
# Used for the Sharpe/Sortino/Treynor risk-free rate (3-Month T-Bill, DGS3MO)
# and Phase 14's Fed funds rate / GDP growth economic-calendar widgets.
# Falls back to hardcoded static figures if unset — never blocks analytics
# or the calendar widget, just less accurate/labeled isLive:false.
FRED_API_KEY=

# ─── Alerts & Notifications (Phase 17) ────────────────────────────────────────
# Email delivery. Free key at https://resend.com. If unset, email
# notifications are skipped (NotificationDispatchService marks the channel
# FAILED_NO_CREDENTIALS if the user enabled it, never fakes a send).
RESEND_API_KEY=
RESEND_FROM_ADDRESS=alerts@richerwealth.app
# Push delivery via Firebase Cloud Messaging. Create a free Firebase project,
# then Project Settings -> Service Accounts -> Generate new private key.
# PRIVATE_KEY must keep its literal "\n" line breaks (paste the JSON value
# as-is, wrapped in quotes). If any of the three is unset, push is skipped
# the same honest way as an unset RESEND_API_KEY. No frontend FCM client/
# service-worker registration exists yet — see STATUS.md's Phase 17 section.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── AI Layer (Phase 19) ───────────────────────────────────────────────────────
# Primary LLM. Real pay-per-use Anthropic key — https://console.anthropic.com.
# If unset, LlmOrchestratorService falls back to the local Ollama provider
# below for every request (this dev environment has no key set — confirmed
# every real chat/report/suggestion call in this build ran on Ollama).
ANTHROPIC_API_KEY=
# Zero-cost fallback (and, when ANTHROPIC_API_KEY is unset, the only path
# that actually runs). Requires the Ollama app/daemon running locally
# (https://ollama.com) with the two models below pulled. This dev
# environment already had Ollama running with `gemma4` pulled — reused as
# the chat model rather than pulling Llama 3/Mistral as the original brief
# suggested, since a real, working model was already present.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=gemma4
# Pulled fresh for this phase (274MB, `ollama pull nomic-embed-text`) — a
# dedicated embedding model gives materially better retrieval than reusing
# a chat model's hidden states, and free/local means no reason not to.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ─── Bank sync (Phase 10) ─────────────────────────────────────────────────────
# Plaid Sandbox — free, US/EU institutions. Sign up at https://dashboard.plaid.com,
# use the Sandbox client ID/secret (never Production/Development ones here).
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# 32-byte key, hex-encoded (64 chars) — generate with `openssl rand -hex 32`.
# Encrypts PlaidItem.accessTokenEncrypted at rest (AES-256-GCM), same scheme
# as MFA_ENCRYPTION_KEY. A separate key so the two secret classes don't share
# blast radius if one leaks.
PLAID_TOKEN_ENCRYPTION_KEY=

# ─── Storage ──────────────────────────────────────────────────────────────────
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=richerwealth-docs

# ─── Email ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=

# ─── FCM (Push notifications) ─────────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
